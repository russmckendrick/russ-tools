---
/**
 * The paste panel — the site's one dispatching control, shared by the index
 * and /404.
 *
 * Hidden in the prerendered HTML and unhidden by `wirePastePanel` on init,
 * exactly as the index's name filter is: a static site cannot dispatch without
 * JS, and a dead control is worse than an absent one.
 *
 * It is a `panel-emphasis`, and DESIGN.md allows exactly one per page — so a
 * page that renders this must not also emphasise something else.
 *
 * `label` differs between the two pages because the question differs. The
 * index asks what you arrived with; /404 already knows the URL failed and is
 * asking what you were actually after.
 */
const { label = 'Start with what you have', value = '' } = Astro.props;
---

<form class="rt-jump" id="rt-jump" hidden>
  <label class="rt-jump-label" for="rt-jump-input">{label}</label>
  <div class="rt-jump-row">
    <input
      class="rt-jump-field"
      id="rt-jump-input"
      type="text"
      autocomplete="off"
      spellcheck="false"
      value={value}
      placeholder="Domain, IP, CIDR, ASN, JWT, PEM, cron, GUID or SKU"
      aria-describedby="rt-jump-desc"
    />
    <button class="rt-jump-go" type="submit">
      Open
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6" />
      </svg>
    </button>
  </div>
  <p class="rt-visually-hidden" id="rt-jump-desc">
    Paste a domain, IP address, CIDR, ASN, JWT, PEM certificate or signing
    request, cron expression, GUID, or a licence code or SKU part number. The tools that can read it are listed below the
    field; Enter opens the first.
  </p>
  <!--
    At rest the row steps through one example at a time. `wirePastePanel`
    swaps it for real matches as soon as something is typed, and restores
    this markup when the field is cleared.
  -->
  <div class="rt-jump-hint" id="rt-jump-hint" data-resting>
    <b>e.g.</b>
    <span class="rt-ticker" aria-hidden="true">
      <span class="rt-ticker-track">
        <span>example.com &rarr; DNS Lookup</span>
        <span>10.0.0.0/22 &rarr; CIDR Workbench</span>
        <span>AS13335 &rarr; BGP &amp; ASN Explorer</span>
        <span>eyJhbGciOi… &rarr; JWT Decoder</span>
        <span>SPE_E3 &rarr; Microsoft 365 License Decoder</span>
        <span>example.com &rarr; DNS Lookup</span>
      </span>
    </span>
  </div>
</form>
