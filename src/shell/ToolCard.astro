---
/**
 * The tool tile — one item of the index's flowing stream.
 *
 * Icon in a `category-fill` tile beside a text column: title and one-line
 * description. Everything comes from the manifest.
 *
 * The route path used to sit under the description. It was the third
 * statement of a fact the title and the link destination both already make,
 * and it cost every tile a line — so the tile is title and sentence now, and
 * the href is left to the browser's status bar.
 *
 * The category badge is gone. The stream has no section headings any more, so
 * the category is stated once — by the hue of the icon tile — instead of three
 * times. `tool.badges` ("A · AAAA · MX · TXT") stays in the search haystack
 * below, so filtering by "MX" still finds the DNS tool even though neither
 * string is drawn.
 *
 * `span` is the tile's width step, and it is what makes the stream a stream:
 * a third of a row or a half of one, never a pixel count, so a row of three
 * thirds and a row of two halves both flush to the same two edges. The
 * cadence that assigns it lives in `src/lib/rowCadence.js`; /404 renders
 * without it and takes the third.
 *
 * A half tile carries the same four lines as a third, with more air around
 * them and its route path pushed to the far corner. Rendering the manifest's
 * `badges` as a row of keys inside it was tried and withdrawn — it read as a
 * row of chips you could press, one control grammar too many on a page that
 * already opens with a chip row.
 *
 * `hidden` lets a page prerender the whole catalogue and reveal a subset —
 * /404 does, so its "did you mean" guess can pick any tool without building
 * card markup a second time in JavaScript.
 *
 * `anchor` puts a category id on the first tile of each run. `/#network` is a
 * compatibility contract — every tool breadcrumb links it and `seo.test.js`
 * checks the built HTML for it — and with the section headings gone the tile
 * is what the browser scrolls to, which lands the reader on the tool rather
 * than on a heading above it.
 *
 * `row` and `col` are the tile's place in the cadence, and they feed the two
 * settles that only the index spends (see DESIGN.md's Motion section):
 *
 *   - `--rt-r` and `--rt-c` stagger the entrance on the diagonal: the delay
 *     is row plus column, so the catalogue deals in as a wave across the
 *     page rather than as one straight line down it. Both are capped in CSS
 *     rather than here, so the tail of a long catalogue lands together
 *     instead of trailing off the clock.
 *   - `view-transition-name` is what lets a filtered tile *travel* to its new
 *     row rather than blink there. It has to be unique among rendered
 *     elements and a valid custom-ident, so it is the manifest id behind a
 *     `t-` prefix — ids are kebab-case and cannot lead with a digit, but the
 *     prefix costs nothing and removes the question.
 *
 * /404 renders this component without them and gets neither: its three
 * suggestions are a fixed grid that never refilters, and a page that opens on
 * an error is the wrong place to deal cards.
 */
import ToolIcon from './ToolIcon.astro';
import { categoryGroupId, categoryVar } from './categories.mjs';

const {
  tool,
  span = 'third',
  row = null,
  col = null,
  anchor = null,
  hidden = false,
} = Astro.props;

/**
 * The link's accessible name. Without this the name is the whole card
 * concatenated — "DNS Lookup Tool Query any record type against Google or
 * Cloudflare DNS over HTTPS. /dns-lookup" — and a links-list rotor of fifteen
 * of those is unusable for the one thing it is for. The visible text still
 * starts with the title, so the accessible name remains contained in it.
 */
const label = tool.title;

/** Pre-lowercased haystack so the index filter never rebuilds it per keystroke. */
const haystack = [tool.title, tool.shortDescription, ...tool.badges].join(' ').toLowerCase();

const motion =
  row === null ? '' : `; --rt-r: ${row}; --rt-c: ${col}; view-transition-name: t-${tool.id}`;
---

<!--
  `categoryVar` sets both hues at once. Two, and they are not interchangeable:
  `--cat` is the TEXT hue, deepened in light mode to clear 4.5:1 on bone;
  `--cat-fill` is the icon tile's solid block, the same bright value in both
  themes because the ink on it is always graphite. Swapping them puts a light
  hue behind graphite text at 1.6:1.

  `data-category` is the group id, not the raw category: filtering has no
  sections left to read, so the card carries its own answer, and azure and
  microsoft both answer "microsoft-azure" exactly as the chips do.
-->
<a
  class="rt-card"
  id={anchor}
  hidden={hidden}
  href={tool.path}
  aria-label={label}
  data-search={haystack}
  data-category={categoryGroupId(tool.category)}
  data-span={span}
  style={`${categoryVar(tool.category)}${motion}`}
>
  <ToolIcon icon={tool.icon} size={19} />
  <span class="rt-card-text">
    <span class="rt-card-name">{tool.title}</span>
    <p>{tool.shortDescription}</p>
  </span>
</a>
