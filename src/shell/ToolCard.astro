---
/**
 * The tool tile — one cell of the index's shared-edge grid.
 *
 * Four things, in order: the icon and the category badge opposed on the first
 * line, the title, a two-line clamped description, and the route path pinned
 * to the bottom. Everything comes from the manifest.
 *
 * The tile used to carry `tool.badges` ("A · AAAA · MX · TXT") along the
 * bottom. Signal's tile has no room for it and the category block does the
 * marking now — but the badges stay in the search haystack below, so filtering
 * by "MX" still finds the DNS tool even though the string is no longer drawn.
 */
import ToolIcon from './ToolIcon.astro';
import { categoryLabel } from './categories.mjs';

const { tool } = Astro.props;

/**
 * The link's accessible name. Without this the name is the whole card
 * concatenated — "DNS Lookup Tool Query any record type against Google or
 * Cloudflare DNS over HTTPS. Network /dns-lookup" — and a links-list rotor of
 * fifteen of those is unusable for the one thing it is for. The visible text
 * still starts with the title, so the accessible name remains contained in it.
 */
const label = tool.title;

/** Pre-lowercased haystack so the index filter never rebuilds it per keystroke. */
const haystack = [tool.title, tool.shortDescription, ...tool.badges].join(' ').toLowerCase();
---

<!--
  Two hues, and they are not interchangeable. `--cat` is the category TEXT hue
  and colours the icon; it is deepened in light mode to clear 4.5:1 on bone.
  `--cat-fill` is the badge block, which is the same bright value in both
  themes because the ink on it is always graphite. Swapping them puts a light
  hue behind graphite text at 1.6:1.
-->
<a
  class="rt-card"
  href={tool.path}
  aria-label={label}
  data-search={haystack}
  style={`--cat: var(--color-category-${tool.category}); --cat-fill: var(--color-category-fill-${tool.category})`}
>
  <span class="rt-card-top">
    <ToolIcon icon={tool.icon} size={20} />
    <span class="rt-card-badge">{categoryLabel(tool.category)}</span>
  </span>
  <span class="rt-card-name">{tool.title}</span>
  <p>{tool.shortDescription}</p>
  <span class="rt-card-foot">
    <span class="rt-go">{tool.path} &rarr;</span>
  </span>
</a>
