---
/**
 * The tool row — one line of the index's catalogue.
 *
 * Glyph tile, title and one-line description, and an arrow that appears on
 * hover or focus. Everything comes from the manifest. `tool.badges`
 * ("A · AAAA · MX · TXT") stays in the search haystack below, so filtering by
 * "MX" still finds the DNS tool even though the string is not drawn.
 *
 * `hidden` lets a page prerender the whole catalogue and reveal a subset —
 * /404 does, so its "did you mean" guess can pick any tool without building
 * row markup a second time in JavaScript.
 *
 * `anchor` puts a category id on the first row of each group. `/#network` is
 * a compatibility contract — every tool breadcrumb links it and `seo.test.js`
 * checks the built HTML for it — and the row is what the browser scrolls to.
 *
 * The index wraps this in `ToolRow.astro`, which adds the pin control and the
 * `view-transition-name` a filtered row travels by. /404 uses it bare.
 *
 * `class="rt-card"` and `data-category` are read by the index script and by
 * the e2e suite, which is why the row keeps the name it had as a tile.
 */
import ToolIcon from './ToolIcon.astro';
import { categoryGroupId } from './categories.mjs';

const { tool, anchor = null, hidden = false } = Astro.props;

/**
 * The link's accessible name. Without this the name is the whole row
 * concatenated, and a links-list rotor of twenty-four of those is unusable.
 * The visible text still starts with the title.
 */
const label = tool.title;

/** Pre-lowercased haystack so the index filter never rebuilds it per keystroke. */
const haystack = [tool.title, tool.shortDescription, ...tool.badges].join(' ').toLowerCase();
---

<a
  class="rt-card"
  id={anchor}
  hidden={hidden}
  href={tool.path}
  aria-label={label}
  data-search={haystack}
  data-category={categoryGroupId(tool.category)}
>
  <ToolIcon icon={tool.icon} size={22} />
  <span class="rt-card-text">
    <span class="rt-card-name">{tool.title}</span>
    <p>{tool.shortDescription}</p>
  </span>
  <svg class="rt-card-go" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M5 12h14M13 6l6 6-6 6" />
  </svg>
</a>
