---
/**
 * The theme control — the last cell in the header nav.
 *
 * It was a palette picker plus a mode toggle. The six alternate palettes went
 * with the Signal redesign, so only the mode toggle remains, and it stays a
 * three-state cycle (system -> light -> dark) rather than the prototype's
 * single static glyph: "follow the system" is a real preference, and an
 * `aria-live` button that announces the state it is in is a real affordance.
 *
 * All three icons and all three labels are in the markup; CSS reveals exactly
 * one from `:root[data-theme-pref]`, so the control is correct on the first
 * frame rather than after hydration.
 */
---

<button
  type="button"
  class="rt-theme-toggle"
  data-theme-toggle
  aria-live="polite"
>
  <svg class="rt-theme-icon" data-for="system" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="2.5" y="4" width="19" height="13" rx="1.5" />
    <path d="M8.5 20.5h7M12 17v3.5" />
  </svg>
  <svg class="rt-theme-icon" data-for="light" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4.2" />
    <path d="M12 2.5v2.2M12 19.3v2.2M4.6 4.6l1.6 1.6M17.8 17.8l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.6 19.4l1.6-1.6M17.8 6.2l1.6-1.6" />
  </svg>
  <svg class="rt-theme-icon" data-for="dark" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M20.5 14.3A8.6 8.6 0 0 1 9.7 3.5a8.6 8.6 0 1 0 10.8 10.8z" />
  </svg>
  <span class="rt-mode-name" data-for="system">System</span>
  <span class="rt-mode-name" data-for="light">Light</span>
  <span class="rt-mode-name" data-for="dark">Dark</span>
</button>

<script>
  import './appearance-controls.js';
</script>
