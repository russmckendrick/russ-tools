---
import AppearanceControls from './AppearanceControls.astro';

const { currentPath } = Astro.props;
---

<div class="rt-header-actions-wrap">
  <button
    type="button"
    class="rt-menu-toggle"
    data-menu-toggle
    aria-expanded="false"
    aria-controls="rt-header-menu"
    aria-label="Open menu"
  >
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
      <path d="M4 7h16M4 12h16M4 17h16" />
    </svg>
  </button>

  <div class="rt-header-actions" id="rt-header-menu" data-header-menu>
    <nav class="rt-topnav" aria-label="Primary">
      <a href="/" aria-label="Tools" title="Tools" aria-current={currentPath === '/' ? 'page' : undefined}>
        <svg class="rt-nav-icon" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="7" height="7" rx="1" />
          <rect x="14" y="3" width="7" height="7" rx="1" />
          <rect x="3" y="14" width="7" height="7" rx="1" />
          <rect x="14" y="14" width="7" height="7" rx="1" />
        </svg>
        <span class="rt-nav-label">Tools</span>
      </a>
      <a href="/delete" aria-label="Saved data" title="Saved data" aria-current={currentPath.startsWith('/delete') ? 'page' : undefined}>
        <svg class="rt-nav-icon" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <ellipse cx="12" cy="5.5" rx="7.5" ry="2.7" />
          <path d="M4.5 5.5v6c0 1.5 3.4 2.7 7.5 2.7s7.5-1.2 7.5-2.7v-6" />
          <path d="M4.5 11.5v6c0 1.5 3.4 2.7 7.5 2.7s7.5-1.2 7.5-2.7v-6" />
        </svg>
        <span class="rt-nav-label">Saved data</span>
      </a>
      <a href="https://github.com/russmckendrick/russ-tools" aria-label="Source" title="Source">
        <svg class="rt-nav-icon" viewBox="0 0 20 20" width="17" height="17" fill="currentColor" aria-hidden="true">
          <path transform="translate(-84 -7399)" d="M94,7399 C99.523,7399 104,7403.59 104,7409.253 C104,7413.782 101.138,7417.624 97.167,7418.981 C96.66,7419.082 96.48,7418.762 96.48,7418.489 C96.48,7418.151 96.492,7417.047 96.492,7415.675 C96.492,7414.719 96.172,7414.095 95.813,7413.777 C98.04,7413.523 100.38,7412.656 100.38,7408.718 C100.38,7407.598 99.992,7406.684 99.35,7405.966 C99.454,7405.707 99.797,7404.664 99.252,7403.252 C99.252,7403.252 98.414,7402.977 96.505,7404.303 C95.706,7404.076 94.85,7403.962 94,7403.958 C93.15,7403.962 92.295,7404.076 91.497,7404.303 C89.586,7402.977 88.746,7403.252 88.746,7403.252 C88.203,7404.664 88.546,7405.707 88.649,7405.966 C88.01,7406.684 87.619,7407.598 87.619,7408.718 C87.619,7412.646 89.954,7413.526 92.175,7413.785 C91.889,7414.041 91.63,7414.493 91.54,7415.156 C90.97,7415.418 89.522,7415.871 88.63,7414.304 C88.63,7414.304 88.101,7413.319 87.097,7413.247 C87.097,7413.247 86.122,7413.234 87.029,7413.87 C87.029,7413.87 87.684,7414.185 88.139,7415.37 C88.139,7415.37 88.726,7417.2 91.508,7416.58 C91.513,7417.437 91.522,7418.245 91.522,7418.489 C91.522,7418.76 91.338,7419.077 90.839,7418.982 C86.865,7417.627 84,7413.783 84,7409.253 C84,7403.59 88.478,7399 94,7399" />
        </svg>
        <span class="rt-nav-label">Source</span>
      </a>
    </nav>

    <AppearanceControls />
  </div>
</div>

<script>
  const menuToggle = document.querySelector('[data-menu-toggle]');
  const headerMenu = document.querySelector('[data-header-menu]');
  const menuWrap = document.querySelector('.rt-header-actions-wrap');

  if (menuToggle && headerMenu && menuWrap) {
    const close = (restoreFocus = false) => {
      const paletteMenu = headerMenu.querySelector('[data-palette-menu]');
      const paletteToggle = headerMenu.querySelector('[data-palette-toggle]');
      if (paletteMenu) paletteMenu.hidden = true;
      paletteToggle?.setAttribute('aria-expanded', 'false');
      menuToggle.setAttribute('aria-expanded', 'false');
      menuToggle.setAttribute('aria-label', 'Open menu');
      if (restoreFocus) menuToggle.focus();
    };

    menuToggle.addEventListener('click', () => {
      const open = menuToggle.getAttribute('aria-expanded') !== 'true';
      menuToggle.setAttribute('aria-expanded', String(open));
      menuToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    });

    headerMenu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') close(true);
    });

    document.addEventListener('pointerdown', (event) => {
      if (!menuWrap.contains(event.target)) close();
    });

    for (const link of headerMenu.querySelectorAll('a')) {
      link.addEventListener('click', () => close());
    }
  }
</script>
