---
/**
 * The header's right-hand side: primary nav plus the theme control.
 *
 * Under Signal these are edge-to-edge cells that fill the header's full
 * height, separated by 1px vertical rules — not pills with gaps, and no icons.
 * The nav used to be icon-only with a label that expanded on hover via a
 * grid-column animation; Signal states its labels outright, which is both
 * plainer and one less thing that moves.
 *
 * The theme toggle is the last cell, so `AppearanceControls` renders inside
 * the same row and inherits the cell rules.
 */
import AppearanceControls from './AppearanceControls.astro';

const { currentPath } = Astro.props;
---

<div class="rt-header-actions-wrap">
  <button
    type="button"
    class="rt-menu-toggle"
    data-menu-toggle
    aria-expanded="false"
    aria-controls="rt-header-menu"
    aria-label="Open menu"
  >
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
      <path d="M4 7h16M4 12h16M4 17h16" />
    </svg>
  </button>

  <div class="rt-header-actions" id="rt-header-menu" data-header-menu>
    <nav class="rt-topnav" aria-label="Primary">
      <a href="/" aria-current={currentPath === '/' ? 'page' : undefined}>
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.106-3.105c.32-.322.863-.22.983.218a6 6 0 0 1-8.259 7.057l-7.91 7.91a1 1 0 0 1-2.999-3l7.91-7.91a6 6 0 0 1 7.057-8.259c.438.12.54.662.219.984z" />
        </svg>
        Tools
      </a>
      <a
        href="/delete"
        aria-current={currentPath.startsWith('/delete') ? 'page' : undefined}
      >
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15.2 3a2 2 0 0 1 1.4.6l3.8 3.8a2 2 0 0 1 .6 1.4V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z" />
          <path d="M17 21v-7a1 1 0 0 0-1-1H8a1 1 0 0 0-1 1v7" />
          <path d="M7 3v4a1 1 0 0 0 1 1h7" />
        </svg>
        Saved data
      </a>
      <a href="https://github.com/russmckendrick/russ-tools">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
          <path d="M9 18c-4.51 2-5-2-7-2" />
        </svg>
        Source
      </a>
    </nav>

    <AppearanceControls />
  </div>
</div>

<script>
  const menuToggle = document.querySelector('[data-menu-toggle]');
  const headerMenu = document.querySelector('[data-header-menu]');
  const menuWrap = document.querySelector('.rt-header-actions-wrap');

  if (menuToggle && headerMenu && menuWrap) {
    const close = (restoreFocus = false) => {
      menuToggle.setAttribute('aria-expanded', 'false');
      menuToggle.setAttribute('aria-label', 'Open menu');
      if (restoreFocus) menuToggle.focus();
    };

    menuToggle.addEventListener('click', () => {
      const open = menuToggle.getAttribute('aria-expanded') !== 'true';
      menuToggle.setAttribute('aria-expanded', String(open));
      menuToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    });

    // On `document`, not on the menu. The old listener was scoped to the menu
    // and so only fired when focus was already inside it — which it was, but
    // only because opening the palette picker moved it there. With the picker
    // gone, an open menu that nothing has focused swallowed Escape entirely.
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      if (menuToggle.getAttribute('aria-expanded') !== 'true') return;
      close(true);
    });

    document.addEventListener('pointerdown', (event) => {
      if (!menuWrap.contains(event.target)) close();
    });

    for (const link of headerMenu.querySelectorAll('a')) {
      link.addEventListener('click', () => close());
    }
  }
</script>
