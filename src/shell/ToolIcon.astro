---
/**
 * A tool's glyph. It draws in `currentColor`; the wrapper it lands in — a
 * catalogue row's tile, the tool page's bright tile — chooses the ink.
 */
import { iconSvg } from './icons.mjs';

const { icon, size = 17, class: className } = Astro.props;
---

<span class:list={['rt-ico', className]}>
  <Fragment set:html={iconSvg(icon, size)} />
</span>
