---
/**
 * The Stacks toolbox: a two-tone mark drawn like every other Stacks object —
 * a bright accent body inside the structural stroke. The body fill is the
 * accent token (with a literal fallback so the same drawing renders outside
 * the token layer, in the OG cards); the stroke is `currentColor`, so the
 * wrapper chooses the structural ink — `--color-rule` in the shell, a
 * literal in the favicon.
 *
 * The clasp — the one detail INSIDE the accent body — is not currentColor:
 * anything sitting on the accent fill takes graphite ink in this system
 * (`on-category-fill`), and a cream clasp on the green measured ~1.3:1 in
 * dark mode and melted into the fill.
 *
 * The old mark was a single-colour silhouette, which rendered as a
 * near-black lump once the accent's text role deepened for light mode.
 *
 * `scripts/generate-og.mjs` inlines this file's inner SVG markup — keep the
 * drawing inside one `<svg>…</svg>` pair.
 */
const { size = 27, class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  aria-hidden="true"
>
  <path
    d="M4 8.5 H20 V18 a1.5 1.5 0 0 1 -1.5 1.5 H5.5 A1.5 1.5 0 0 1 4 18 Z"
    fill="var(--color-primary, #6ee787)"
    stroke="currentColor"
    stroke-width="2"
    stroke-linejoin="round"
  />
  <path
    d="M9 8.5 V6.8 A1.8 1.8 0 0 1 10.8 5 h2.4 A1.8 1.8 0 0 1 15 6.8 V8.5"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    fill="none"
  />
  <path
    d="M10 13 h4"
    stroke="var(--color-on-category-fill, #17150f)"
    stroke-width="2"
    stroke-linecap="round"
    fill="none"
  />
</svg>
