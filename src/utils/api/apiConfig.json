{
  "endpoints": {
    "tenant": {
      "url": "/api/tenant",
      "description": "Microsoft Tenant Lookup API",
      "timeout": 10000,
      "retries": 2
    },
    "ssl": {
      "url": "/api/ssl",
      "description": "SSL Certificate Checker API",
      "timeout": 15000,
      "retries": 2
    },
    "whois": {
      "url": "/api/whois",
      "description": "WHOIS Lookup API",
      "timeout": 10000,
      "retries": 2
    },
    "headers": {
      "url": "/api/headers",
      "description": "HTTP Security Headers API",
      "timeout": 12000,
      "retries": 1
    },
    "dns": {
      "google": "https://dns.google/resolve",
      "cloudflare": "https://1.1.1.1/dns-query",
      "description": "DNS over HTTPS providers with public JSON APIs",
      "timeout": 8000,
      "retries": 1
    },
    "external": {
      "azure_portal": "https://portal.azure.com",
      "description": "External third-party APIs",
      "timeout": 10000,
      "retries": 1
    }
  },
  "defaults": {
    "timeout": 10000,
    "retries": 2,
    "headers": {
      "Accept": "application/json"
    }
  }
} 