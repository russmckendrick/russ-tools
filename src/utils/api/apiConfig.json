{
  "endpoints": {
    "tenant": {
      "url": "https://tenant.russ.tools/",
      "description": "Microsoft Tenant Lookup API",
      "timeout": 10000,
      "retries": 2
    },
    "ssl": {
      "url": "https://ssl.russ.tools/",
      "description": "SSL Certificate Checker API",
      "timeout": 15000,
      "retries": 2
    },
    "whois": {
      "url": "https://whois.russ.tools/",
      "description": "WHOIS Lookup API",
      "timeout": 10000,
      "retries": 2
    },
    "dns": {
      "google": "https://dns.google/resolve",
      "cloudflare": "https://1.1.1.1/dns-query",
      "opendns": "https://dns.google/resolve",
      "auto": "https://dns.google/resolve",
      "description": "DNS over HTTPS providers (OpenDNS and auto fall back to Google as they lack public DoH JSON API)",
      "timeout": 8000,
      "retries": 1
    },
    "external": {
      "azure_portal": "https://portal.azure.com",
      "description": "External third-party APIs",
      "timeout": 10000,
      "retries": 1
    }
  },
  "defaults": {
    "timeout": 10000,
    "retries": 2,
    "headers": {
      "Accept": "application/json"
    }
  }
} 