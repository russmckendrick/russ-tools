---
/**
 * The tool index. Entirely derived from the registry — adding tool #16
 * changes nothing in this file.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCard from '../shell/ToolCard.astro';
import { TOOLS, groupedByCategory } from '../tools/registry.mjs';
import { PERSON_SCHEMA, SITE_DESCRIPTION, SITE_NAME, SITE_URL, WEBSITE_ID } from '../shell/site.mjs';

/**
 * The index published no structured data at all, so nothing tied the fifteen
 * tool pages to a site or an author. The WebSite node is what a crawler reads
 * the tool pages' `isPartOf` against; the ItemList states outright that this
 * page is a catalogue and what is in it.
 */
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    // Same id the tool pages' `isPartOf` names, so the sixteen documents
    // describe one site rather than sixteen sites with identical names.
    '@id': WEBSITE_ID,
    name: SITE_NAME,
    url: SITE_URL,
    description: SITE_DESCRIPTION,
    inLanguage: 'en',
    author: PERSON_SCHEMA,
    publisher: PERSON_SCHEMA,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Tools',
    numberOfItems: TOOLS.length,
    itemListElement: TOOLS.map((tool, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: tool.title,
      description: tool.shortDescription,
      url: `${SITE_URL}${tool.path}`,
    })),
  },
];

const categoryGroups = groupedByCategory();
const azure = categoryGroups.find((group) => group.id === 'azure');
const microsoft = categoryGroups.find((group) => group.id === 'microsoft');
const groups = categoryGroups.flatMap((group) => {
  if (group.id === 'microsoft') return [];
  if (group.id !== 'azure') {
    return [
      {
        ...group,
        accent: `var(--color-category-${group.id})`,
        accentFill: `var(--color-category-fill-${group.id})`,
      },
    ];
  }

  return [
    {
      id: 'microsoft-azure',
      label: 'Microsoft & Azure',
      // A category hue, not `--color-primary`. The accent is engineered as an
      // *action* colour and does not clear 4.5:1 as text on the light ground
      // in Tokyo Night (3.59:1), Nord (4.05:1) or Catppuccin (4.34:1) — the
      // palette that ships by default. `tokens.contrast.test.js` validates
      // token pairs, so it could not see a page putting an action colour into
      // a text slot; `category-accent.test.js` now guards that.
      accent: 'var(--color-category-azure)',
      accentFill: 'var(--color-category-fill-azure)',
      tools: [...azure.tools, ...microsoft.tools].sort((a, b) => a.title.localeCompare(b.title)),
    },
  ];
});
---

<BaseLayout
  title="russ.tools — client-side network, cloud and developer utilities"
  description="Fifteen small utilities for people who work with networks, cloud platforms and certificates. Subnet planning, DNS and WHOIS lookups, Azure naming, JWTs, encoders and converters — all running entirely in your browser."
  keywords={['network tools', 'subnet calculator', 'dns lookup', 'whois', 'azure naming', 'jwt decoder', 'base64', 'developer tools']}
  schema={schema}
>
  <!--
    No hero and no stat strip. Both were selling the site to someone already
    on it: a headline that repeated the footer's claim, a subtitle that
    repeated the headline, and four tiles of which two ("100% client-side",
    "0 trackers") were slogans wearing a number's clothes. The h1 stays
    because the page needs one; it says what the page is and stops.

    The count beside it is the one piece of orientation that earns its place,
    and it is set mono on the same baseline rather than as a second heading.
  -->
  <div class="rt-index-head">
    <h1 class="rt-index-title">Tools</h1>
    <span class="rt-index-count">
      {TOOLS.length} utilities &middot; everything runs in your browser
    </span>
  </div>

  <!--
    A radio group, not six toggles. The categories are mutually exclusive, so
    `aria-pressed` on six buttons was describing six independent switches; a
    radiogroup announces "3 of 6" and costs one tab stop rather than six.

    The name filter now sits at the end of this same row rather than above it,
    so the whole filtering affordance is one ruled band.
  -->
  <div class="rt-filters">
    <div id="filters" class="rt-chips" role="radiogroup" aria-label="Filter tools by category">
      <button class="rt-chip" type="button" role="radio" data-filter="all" aria-checked="true">
        All <span class="rt-chip-count">{TOOLS.length}</span>
      </button>
      {
        groups.map((g) => (
          <button
            class="rt-chip"
            type="button"
            role="radio"
            data-filter={g.id}
            aria-checked="false"
            tabindex="-1"
          >
            {g.label} <span class="rt-chip-count">{g.tools.length}</span>
          </button>
        ))
      }
    </div>

    <div class="rt-find">
      <!--
        Hidden in the prerendered HTML and unhidden on init, so the no-JS
        fallback is the full catalogue rather than a filter that does nothing.
      -->
      <input
        class="rt-find-input"
        id="rt-find"
        type="search"
        hidden
        autocomplete="off"
        spellcheck="false"
        placeholder="Filter by name  /"
        aria-label="Filter tools by name"
        aria-describedby="rt-find-hint"
      />
      <p class="rt-visually-hidden" id="rt-find-hint">
        Typing searches every tool and clears the selected category.
      </p>
    </div>
  </div>

  <p class="rt-visually-hidden" id="rt-status" role="status" aria-live="polite"></p>

  <div class="rt-board" id="board">
    {
      groups.map((g) => (
        <section
          class="rt-group"
          id={g.id}
          data-category={g.id}
          data-count={g.tools.length}
          aria-labelledby={`${g.id}-label`}
          style={`--cat: ${g.accent}; --cat-fill: ${g.accentFill}`}
        >
          <div class="rt-group-head">
            {/*
              A real heading. These five labels are the only structural
              navigation the page has, and as `<b>` they were invisible to a
              heading rotor — one h1 for a fifteen-item catalogue. The link
              makes a demoted group head clickable in filtered view without
              needing separate markup for it.
            */}
            <h2 class="rt-group-label" id={`${g.id}-label`}>
              <a href={`#${g.id}`}>{g.label}</a>
            </h2>
            <span class="rt-group-count" aria-hidden="true">
              {g.tools.length}
            </span>
            <hr />
          </div>
          <div class="rt-grid">
            {g.tools.map((tool) => (
              <ToolCard tool={tool} />
            ))}
          </div>
        </section>
      ))
    }
    <p class="rt-empty" id="rt-empty" hidden>
      No tool matches <b id="rt-empty-q"></b>. <button type="button" id="rt-empty-clear">Clear the filter</button>
    </p>
  </div>
</BaseLayout>

<script>
  /**
   * The index filter. Two controls over one prerendered catalogue: a category
   * radio group and a name filter. Neither hides anything the user cannot get
   * back to in one click, and both are readable off the URL.
   *
   * Without this script the page is the full catalogue — the search input
   * stays `hidden`, every group renders, and `/#network` still scrolls to the
   * network section because the id is on the prerendered element.
   */
  const board = document.getElementById('board');
  const filters = document.getElementById('filters');
  const chips = [...filters.querySelectorAll('.rt-chip')];
  const groups = [...board.querySelectorAll('.rt-group')];
  const cards = [...board.querySelectorAll('.rt-card')];
  const status = document.getElementById('rt-status');
  const empty = document.getElementById('rt-empty');
  const emptyQ = document.getElementById('rt-empty-q');
  const find = document.getElementById('rt-find');

  const CATEGORIES = new Set(groups.map((g) => g.dataset.category));
  const TOTAL = cards.length;

  let category = 'all';
  let query = '';

  const plural = (n) => `${n} ${n === 1 ? 'tool' : 'tools'}`;

  /**
   * Filtering used to hide the other four groups outright, which on
   * `/#content` left one card in the corner of an otherwise empty page —
   * the void DESIGN.md's own No Void Rule calls a bug. The selected group is
   * promoted instead, and the rest stay on the page as a row of counted
   * headings: the page keeps its height, and the other fourteen tools are
   * one click away rather than gone.
   */
  const render = () => {
    const q = query.trim().toLowerCase();
    const searching = q !== '';
    let visible = 0;

    for (const card of cards) {
      const hit = !searching || card.dataset.search.includes(q);
      card.hidden = !hit;
      if (hit) visible += 1;
    }

    board.classList.toggle('is-filtered', !searching && category !== 'all');
    board.classList.toggle('is-searching', searching);

    for (const group of groups) {
      const isActive = group.dataset.category === category;
      const matches = [...group.querySelectorAll('.rt-card')].filter((c) => !c.hidden).length;

      // Searching flattens the board: every group that still has a hit shows
      // its cards, so a name filter never depends on guessing the category.
      group.hidden = searching && matches === 0;
      group.toggleAttribute('data-demoted', !searching && category !== 'all' && !isActive);
      group.classList.toggle('is-active', !searching && isActive);
    }

    empty.hidden = !(searching && visible === 0);
    if (!empty.hidden) emptyQ.textContent = `“${query.trim()}”`;

    for (const chip of chips) {
      const on = chip.dataset.filter === category;
      chip.setAttribute('aria-checked', String(on));
      chip.tabIndex = on ? 0 : -1;
    }

    status.textContent = searching
      ? visible === 0
        ? `No tool matches “${query.trim()}”`
        : `${plural(visible)} ${visible === 1 ? 'matches' : 'match'} “${query.trim()}”`
      : category === 'all'
        ? `Showing all ${plural(TOTAL)}`
        : `Showing ${plural(Number(document.getElementById(category).dataset.count))} in ${
            document.getElementById(`${category}-label`).textContent.trim()
          }`;
  };

  /**
   * The filtered view is a real destination — every tool page's breadcrumb
   * already links `/#network` and the listener below already honours it — so
   * the control that produces it writes it. Back then clears the filter
   * instead of leaving the site. The query rides in `?q=` on replaceState so
   * a search is shareable without putting a history entry per keystroke.
   */
  const writeUrl = (push) => {
    const url = new URL(location.href);
    url.hash = !query.trim() && category !== 'all' ? category : '';
    if (query.trim()) url.searchParams.set('q', query.trim());
    else url.searchParams.delete('q');
    const next = url.pathname + url.search + url.hash;
    if (next === location.pathname + location.search + location.hash) return;
    history[push ? 'pushState' : 'replaceState'](null, '', next);
  };

  const setCategory = (next, push = true) => {
    category = CATEGORIES.has(next) ? next : 'all';
    if (query) {
      query = '';
      find.value = '';
    }
    render();
    writeUrl(push);
  };

  const readUrl = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    const q = new URL(location.href).searchParams.get('q') ?? '';
    query = q;
    find.value = q;
    category = !q && CATEGORIES.has(id) ? id : 'all';
    render();
  };

  filters.addEventListener('click', (event) => {
    const chip = event.target instanceof Element ? event.target.closest('.rt-chip') : null;
    if (chip) setCategory(chip.dataset.filter);
  });

  // Roving tabindex: one tab stop for the group, arrows to move within it.
  filters.addEventListener('keydown', (event) => {
    const dir = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[event.key];
    const jump = event.key === 'Home' ? 0 : event.key === 'End' ? chips.length - 1 : null;
    if (dir === undefined && jump === null) return;
    event.preventDefault();
    const i = chips.findIndex((c) => c.dataset.filter === category);
    const next = jump ?? (i + dir + chips.length) % chips.length;
    setCategory(chips[next].dataset.filter);
    chips[next].focus();
  });

  // The board is one anchor per category, so a heading link filters to it.
  board.addEventListener('click', (event) => {
    const link = event.target instanceof Element ? event.target.closest('.rt-group-label a') : null;
    if (!link) return;
    event.preventDefault();
    setCategory(new URL(link.href).hash.slice(1));
  });

  document.getElementById('rt-empty-clear').addEventListener('click', () => {
    query = '';
    find.value = '';
    render();
    writeUrl(false);
    find.focus();
  });

  let pending;
  find.addEventListener('input', () => {
    query = find.value;
    if (query.trim()) category = 'all';
    render();
    clearTimeout(pending);
    pending = setTimeout(() => writeUrl(false), 250);
  });

  find.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !find.value) return;
    query = '';
    find.value = '';
    render();
    writeUrl(false);
  });

  // `/` is the convention for "filter this list" and costs nothing to learn.
  document.addEventListener('keydown', (event) => {
    if (event.key !== '/' || event.metaKey || event.ctrlKey || event.altKey) return;
    const el = document.activeElement;
    if (el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement) return;
    event.preventDefault();
    find.focus();
    find.select();
  });

  window.addEventListener('hashchange', readUrl);
  window.addEventListener('popstate', readUrl);

  find.hidden = false;
  readUrl();
</script>
