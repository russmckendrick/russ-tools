---
/**
 * The tool index. Entirely derived from the registry — adding tool #16
 * changes nothing in this file.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PastePanel from '../shell/PastePanel.astro';
import ToolCard from '../shell/ToolCard.astro';
import { TOOLS } from '../tools/registry.mjs';
import { categoryGroupId, categoryLabel } from '../shell/categories.mjs';
import { PERSON_SCHEMA, SITE_DESCRIPTION, SITE_NAME, SITE_URL, WEBSITE_ID } from '../shell/site.mjs';

/**
 * The index published no structured data at all, so nothing tied the eighteen
 * tool pages to a site or an author. The WebSite node is what a crawler reads
 * the tool pages' `isPartOf` against; the ItemList states outright that this
 * page is a catalogue and what is in it.
 */
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    // Same id the tool pages' `isPartOf` names, so the sixteen documents
    // describe one site rather than sixteen sites with identical names.
    '@id': WEBSITE_ID,
    name: SITE_NAME,
    url: SITE_URL,
    description: SITE_DESCRIPTION,
    inLanguage: 'en',
    author: PERSON_SCHEMA,
    publisher: PERSON_SCHEMA,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Tools',
    numberOfItems: TOOLS.length,
    itemListElement: TOOLS.map((tool, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: tool.title,
      description: tool.shortDescription,
      url: `${SITE_URL}${tool.path}`,
    })),
  },
];

/**
 * The chips, and only the chips, carry the category names now.
 *
 * The merge lives in `categoryGroupId` — azure and microsoft answer
 * "microsoft-azure" — and this page reads it rather than restating it. It used
 * to restate it, in a second form, and the tool breadcrumbs link
 * `/#microsoft-azure` off the shared helper: if the two ever disagreed, every
 * Microsoft and Azure breadcrumb would point at an anchor the index does not
 * render.
 */
const groups = [];
for (const tool of TOOLS) {
  const id = categoryGroupId(tool.category);
  const group = groups.find((g) => g.id === id);
  if (group) group.count += 1;
  else groups.push({ id, label: id === 'microsoft-azure' ? 'Microsoft & Azure' : categoryLabel(tool.category), count: 1 });
}

/**
 * The tile's width, and the reason the stream is a stream.
 *
 * Three steps, not a curve. The first attempt scaled width continuously off
 * the same two lengths and produced eighteen widths inside a 55px band, which
 * packed straight back into a perfect 3×5 — the grid this replaces, minus the
 * headings. Distinct steps are what make rows break at 3, 2, 3, 3 and 4.
 *
 * Title outweighs description because a wrapped title is what actually makes a
 * tile look cramped.
 */
const widthStep = (tool) => {
  const weight = tool.title.length + tool.shortDescription.length / 3;
  return weight <= 36 ? 235 : weight <= 41 ? 315 : 400;
};

/**
 * `/#network` is a compatibility contract: every tool page's breadcrumb links
 * it, `seo.test.js` walks those links against the built HTML, and the id has
 * to be on something the browser can scroll to. With the sections gone it goes
 * on the first tile of each run — which lands the reader on the tool rather
 * than on a heading above it — and a visually-hidden h2 goes beside it so a
 * heading rotor still has more than one entry.
 */
const seen = new Set();
const cards = TOOLS.map((tool) => {
  const id = categoryGroupId(tool.category);
  const first = !seen.has(id);
  seen.add(id);
  return { tool, anchor: first ? id : null, label: groups.find((g) => g.id === id).label };
});
---

<BaseLayout
  title="russ.tools — client-side network, cloud and developer utilities"
  description="Eighteen small utilities for people who work with networks, cloud platforms and certificates. Subnet planning, DNS and WHOIS lookups, Azure naming, JWTs, encoders and converters — all running entirely in your browser."
  keywords={['network tools', 'subnet calculator', 'dns lookup', 'whois', 'azure naming', 'jwt decoder', 'base64', 'developer tools']}
  schema={schema}
>
  <!--
    No hero and no stat strip. Both were selling the site to someone already
    on it. The h1 stays because the page needs one; it says what the page is
    and stops, and it shares its band with one mono line so the head does work
    instead of floating over 90px of nothing.
  -->
  <div class="rt-index-head">
    <h1 class="rt-index-title">Tools</h1>
    <span class="rt-index-note">
      <span class="rt-index-count" id="rt-count">{TOOLS.length}</span> tools · nothing leaves the browser
    </span>
  </div>

  <!--
    The page's one emphasis panel, and it is a control rather than a slogan:
    paste what you already have and it opens the tool that reads it. Shared
    with /404, which asks the same question from the other end.
  -->
  <PastePanel />

  <!--
    A radio group, not six toggles. The categories are mutually exclusive, so
    `aria-pressed` on six buttons was describing six independent switches; a
    radiogroup announces "3 of 6" and costs one tab stop rather than six.
  -->
  <div class="rt-filters">
    <div id="filters" class="rt-chips" role="radiogroup" aria-label="Filter tools by category">
      <button class="rt-chip" type="button" role="radio" data-filter="all" aria-checked="true">
        All <span class="rt-chip-count">{TOOLS.length}</span>
      </button>
      {
        groups.map((g) => (
          <button
            class="rt-chip"
            type="button"
            role="radio"
            data-filter={g.id}
            aria-checked="false"
            tabindex="-1"
          >
            {g.label} <span class="rt-chip-count">{g.count}</span>
          </button>
        ))
      }
    </div>

    <div class="rt-find">
      <!--
        Hidden in the prerendered HTML and unhidden on init, so the no-JS
        fallback is the full catalogue rather than a filter that does nothing.
      -->
      <input
        class="rt-find-input"
        id="rt-find"
        type="search"
        hidden
        autocomplete="off"
        spellcheck="false"
        placeholder="Filter by name  /"
        aria-label="Filter tools by name"
        aria-describedby="rt-find-hint"
      />
      <p class="rt-visually-hidden" id="rt-find-hint">
        Typing searches every tool and clears the selected category.
      </p>
    </div>
  </div>

  <p class="rt-visually-hidden" id="rt-status" role="status" aria-live="polite"></p>

  <!--
    One stream, no sections. The chips name the categories and the icon tile
    carries the hue, so a heading above each run was the third statement of the
    same fact — and the bands it created were what made a catalogue of eighteen
    read as five stacked tables. Tools stay in category order, so the hues
    cluster and drift down the page: the grouping is drawn, not labelled.
  -->
  <div class="rt-stream" id="board">
    {
      cards.map(({ tool, anchor, label }, i) => (
        <>
          {anchor && <h2 class="rt-visually-hidden">{label}</h2>}
          <ToolCard tool={tool} widthStep={widthStep(tool)} anchor={anchor} order={i} />
        </>
      ))
    }
    <p class="rt-empty" id="rt-empty" hidden>
      No tool matches <b id="rt-empty-q"></b>. <button type="button" id="rt-empty-clear">Clear the filter</button>
    </p>
  </div>
</BaseLayout>

<script>
  /**
   * The index's client behaviour: a paste dispatcher and two filters over one
   * prerendered catalogue.
   *
   * Filtering no longer promotes one group and demotes the rest — there are no
   * groups on the page to promote. A category chip hides the tiles that do not
   * carry its `data-category`, which is the whole of it.
   *
   * Without this script the page is the full catalogue: the search input and
   * the paste panel stay `hidden`, every tile renders, and `/#network` still
   * scrolls to the first network tool because the id is on the prerendered
   * tile.
   */
  import { wirePastePanel } from '../lib/pastePanel.js';

  const board = document.getElementById('board');
  const filters = document.getElementById('filters');
  const chips = [...filters.querySelectorAll('.rt-chip')];
  const cards = [...board.querySelectorAll('.rt-card')];
  const status = document.getElementById('rt-status');
  const empty = document.getElementById('rt-empty');
  const emptyQ = document.getElementById('rt-empty-q');
  const find = document.getElementById('rt-find');
  const count = document.getElementById('rt-count');

  const CATEGORIES = new Set(cards.map((c) => c.dataset.category));
  const TOTAL = cards.length;
  const COUNTS = Object.fromEntries(
    chips.map((chip) => [chip.dataset.filter, Number(chip.querySelector('.rt-chip-count').textContent)])
  );
  const LABELS = Object.fromEntries(
    chips.map((chip) => [chip.dataset.filter, chip.textContent.replace(/\s*\d+\s*$/, '').trim()])
  );

  let category = 'all';
  let query = '';

  const plural = (n) => `${n} ${n === 1 ? 'tool' : 'tools'}`;

  /*
    Read live, not once: the setting can change under a session, and a page
    left open across that change should honour the new answer rather than the
    one that happened to hold at load.
  */
  const still = window.matchMedia('(prefers-reduced-motion: reduce)');

  /*
    The mono count beside the h1. It read `15` while the page showed three,
    because nothing was updating it — `#rt-status` was carrying the whole
    announcement and only screen readers heard it.

    The 90ms fade is WAAPI rather than CSS because the element persists and
    only its text changes, which re-triggers no keyframe; `globals.css`'s
    reduced-motion block cannot reach a script-driven animation either, so
    `still` is checked here rather than relied on downstream.
  */
  const tick = (visible) => {
    const next = visible === TOTAL ? String(TOTAL) : `${visible} / ${TOTAL}`;
    if (next === count.textContent) return;
    count.textContent = next;
    count.toggleAttribute('data-filtered', visible !== TOTAL);
    if (still.matches) return;
    count.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 90, easing: 'ease-out' });
  };

  const render = () => {
    const q = query.trim().toLowerCase();
    const searching = q !== '';
    let visible = 0;

    for (const card of cards) {
      const matchesName = !searching || card.dataset.search.includes(q);
      const matchesCategory = searching || category === 'all' || card.dataset.category === category;
      const hit = matchesName && matchesCategory;
      card.hidden = !hit;
      if (hit) visible += 1;
    }

    empty.hidden = !(searching && visible === 0);
    if (!empty.hidden) emptyQ.textContent = `“${query.trim()}”`;
    tick(visible);

    for (const chip of chips) {
      const on = chip.dataset.filter === category;
      chip.setAttribute('aria-checked', String(on));
      chip.tabIndex = on ? 0 : -1;
    }

    status.textContent = searching
      ? visible === 0
        ? `No tool matches “${query.trim()}”`
        : `${plural(visible)} ${visible === 1 ? 'matches' : 'match'} “${query.trim()}”`
      : category === 'all'
        ? `Showing all ${plural(TOTAL)}`
        : `Showing ${plural(COUNTS[category])} in ${LABELS[category]}`;
  };

  /**
   * The filtered view is a real destination — every tool page's breadcrumb
   * already links `/#network` and the listener below already honours it — so
   * the control that produces it writes it. Back then clears the filter
   * instead of leaving the site. The query rides in `?q=` on replaceState so
   * a search is shareable without putting a history entry per keystroke.
   */
  const writeUrl = (push) => {
    const url = new URL(location.href);
    url.hash = !query.trim() && category !== 'all' ? category : '';
    if (query.trim()) url.searchParams.set('q', query.trim());
    else url.searchParams.delete('q');
    const next = url.pathname + url.search + url.hash;
    if (next === location.pathname + location.search + location.hash) return;
    history[push ? 'pushState' : 'replaceState'](null, '', next);
  };

  /*
    Rearranging the stream, with the survivors travelling rather than
    teleporting.

    Each tile carries a `view-transition-name`, so `startViewTransition` FLIPs
    the reflow: the tiles that survive the filter slide to their new rows and
    the ones that go fade out where they stood. `shell.css` silences the root
    group so only the tiles move.

    Three ways this declines, all of them landing on today's instant reflow:
    the reduced-motion setting, a browser with no same-document view
    transitions, and — deliberately — every path that is not a discrete
    choice. Typing in the name filter calls `render()` directly, because a
    transition per keystroke queues, skips and stutters; only pressing a chip
    is a decision worth animating.
  */
  const settle = (mutate) => {
    if (still.matches || !document.startViewTransition) return mutate();
    document.startViewTransition(mutate);
  };

  const setCategory = (next, push = true) => {
    category = CATEGORIES.has(next) ? next : 'all';
    if (query) {
      query = '';
      find.value = '';
    }
    settle(render);
    writeUrl(push);
  };

  /*
    `animate` is false for the one call at init and true for the two history
    listeners. Back and forward are discrete choices like a chip press and
    settle the same way; the initial read is a page load, where the tiles have
    their own deal-in and a view transition over it would be two entrances
    fighting for the same 400ms.
  */
  const readUrl = (animate = false) => {
    const id = decodeURIComponent(location.hash.slice(1));
    const q = new URL(location.href).searchParams.get('q') ?? '';
    query = q;
    find.value = q;
    category = !q && CATEGORIES.has(id) ? id : 'all';
    if (animate) settle(render);
    else render();
  };

  filters.addEventListener('click', (event) => {
    const chip = event.target instanceof Element ? event.target.closest('.rt-chip') : null;
    if (chip) setCategory(chip.dataset.filter);
  });

  // Roving tabindex: one tab stop for the group, arrows to move within it.
  filters.addEventListener('keydown', (event) => {
    const dir = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[event.key];
    const jumpTo = event.key === 'Home' ? 0 : event.key === 'End' ? chips.length - 1 : null;
    if (dir === undefined && jumpTo === null) return;
    event.preventDefault();
    const i = chips.findIndex((c) => c.dataset.filter === category);
    const next = jumpTo ?? (i + dir + chips.length) % chips.length;
    setCategory(chips[next].dataset.filter);
    chips[next].focus();
  });

  document.getElementById('rt-empty-clear').addEventListener('click', () => {
    query = '';
    find.value = '';
    // Not a keystroke: one press that puts all eighteen tiles back, which is
    // the largest rearrangement the page can make and the clearest case for
    // showing where they land.
    settle(render);
    writeUrl(false);
    find.focus();
  });

  let pending;
  find.addEventListener('input', () => {
    query = find.value;
    if (query.trim()) category = 'all';
    render();
    clearTimeout(pending);
    pending = setTimeout(() => writeUrl(false), 250);
  });

  find.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !find.value) return;
    query = '';
    find.value = '';
    settle(render);
    writeUrl(false);
  });

  // `/` is the convention for "filter this list" and costs nothing to learn.
  document.addEventListener('keydown', (event) => {
    if (event.key !== '/' || event.metaKey || event.ctrlKey || event.altKey) return;
    const el = document.activeElement;
    if (el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement) return;
    event.preventDefault();
    find.focus();
    find.select();
  });

  window.addEventListener('hashchange', () => readUrl(true));
  window.addEventListener('popstate', () => readUrl(true));

  find.hidden = false;
  readUrl();

  // No autofocus: stealing focus on a catalogue would hijack the scroll
  // position and pop a keyboard on every phone that opens the site.
  wirePastePanel();
</script>
