---
/**
 * The page shell: head, theme, topbar, footer.
 *
 * Tools never import this, and never import SEO or config — they render
 * inside it and declare what they need in their manifest. That is what keeps
 * the "tool #16 is one new folder" property true.
 */
import '../styles/globals.css';
import '../styles/shell.css';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import HeaderActions from '../shell/HeaderActions.astro';
import SiteMark from '../shell/SiteMark.astro';
import { DEFAULT_PALETTE, paletteIds } from '../shell/palettes.mjs';

const {
  title,
  description,
  keywords = [],
  // `Astro.url.pathname` is the *output file* during a static build, so the
  // index resolved to `https://russ.tools/index.html` and /delete to
  // `/delete.html` — self-referencing canonicals pointing at URLs nobody
  // links to, which is the one SEO fault a canonical tag can actually cause.
  // Cloudflare Pages serves the extensionless path, so that is the canonical
  // one. Tool pages pass their manifest path explicitly and were never
  // affected. Caught by the rendered-meta diff; pinned by canonical.test.js.
  canonical = new URL(
    Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, ''),
    Astro.site
  ).href,
  schema,
  // For pages that are a control panel rather than content — /delete. The
  // sitemap is built from the registry and never listed them, but a link
  // from every page's nav is enough for a crawler to find one anyway.
  noindex = false,
} = Astro.props;

---

<!doctype html>
<html
  lang="en"
  data-default-palette={DEFAULT_PALETTE}
  data-palette-options={paletteIds.join(' ')}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/assets/logo.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, follow" />}

    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="russ.tools" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    <!--
      Theme before first paint. This runs synchronously in the head, so the
      correct ground is painted rather than flashing the default and
      correcting. `vite-ui-theme` is the key the React app already writes, so
      a visitor's existing choice carries straight over to the new shell.
      Dark is the default; only an explicit light choice, or a system
      preference with no stored choice, moves off it.
    -->
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('vite-ui-theme') || 'system';
          const light =
            stored === 'light' ||
            (stored === 'system' && window.matchMedia('(prefers-color-scheme: light)').matches);
          document.documentElement.classList.add(light ? 'light' : 'dark');
          const palette = localStorage.getItem('russ-tools-palette');
          const palettes = document.documentElement.dataset.paletteOptions.split(' ');
          const defaultPalette = document.documentElement.dataset.defaultPalette;
          document.documentElement.dataset.palette = palettes.includes(palette)
            ? palette
            : defaultPalette;
          // The toggle's icon is chosen from this in CSS, so it is correct on
          // the first frame rather than after hydration.
          document.documentElement.dataset.themePref = stored;
        } catch {
          document.documentElement.classList.add('dark');
          document.documentElement.dataset.themePref = 'dark';
          document.documentElement.dataset.palette =
            document.documentElement.dataset.defaultPalette;
        }
      })();
    </script>
  </head>

  <body>
    <div class="rt-ambient" aria-hidden="true"></div>

    <header class="rt-site-header">
      <div class="rt-shell">
        <div class="rt-topbar">
          <a class="rt-brand" href="/">
            <SiteMark class="rt-site-mark" />
            <span>russ.tools</span>
          </a>
          <HeaderActions currentPath={Astro.url.pathname} />
        </div>
      </div>
    </header>

    <main class="rt-shell">
      <slot />
    </main>

    <footer class="rt-site-footer">
      <div class="rt-shell rt-footer-inner">
        <a class="rt-footer-brand" href="/">
          <SiteMark size={19} />
          <span>russ.tools</span>
        </a>
        <div class="rt-shell-foot">
          <span>Client-side only</span>
          <span>No analytics</span>
          <span>No accounts</span>
        </div>
        <nav class="rt-footnav" aria-label="Footer">
          <a href="/">Tools</a>
          <a href="/delete">Saved data</a>
          <a href="https://github.com/russmckendrick/russ-tools">Source</a>
        </nav>
      </div>
    </footer>

  </body>
</html>
